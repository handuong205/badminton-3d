{
  "name": "badminton-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @badminton/client",
    "dev:lan": "npm run dev -w @badminton/client -- --host",
    "server": "npm run dev -w @badminton/server",
    "build": "npm run build -w @badminton/client",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}